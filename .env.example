# Copy to .env for local overrides. The docker-compose stack supplies these same
# defaults inline, so a clean `docker compose up` works without a .env.

# --- Database ---
POSTGRES_USER=tovira
POSTGRES_PASSWORD=tovira
POSTGRES_DB=tovira
DB_PORT=5432

# Connection string used by the API (host `db` inside compose, `localhost` outside).
DATABASE_URL=postgres://tovira:tovira@localhost:5432/tovira

# Non-superuser role the API uses for request queries so Postgres RLS is enforced
# (created by migration 0003). Leave unset to fall back to DATABASE_URL.
APP_DATABASE_URL=postgres://tovira_app:tovira_app@localhost:5432/tovira
APP_DB_PASSWORD=tovira_app

# --- API ---
NODE_ENV=development
PORT=3001
API_PORT=3001

# --- Auth (P0-3) ---
# memory = ephemeral in-process store; postgres = durable (default for the app).
AUTH_STORE=postgres
SESSION_TTL_HOURS=168

# Public base URL of the app — becomes the link inside every email (password
# reset, email confirmation). MUST be a real https URL in production.
APP_BASE_URL=http://localhost:5173

# --- AI / model routing (P0-2, P1-9 hybrid) ---
# stub = deterministic canned model (no key); anthropic = real API (needs ANTHROPIC_API_KEY).
MODEL_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Extraction is gate-locked to Sonnet (never guesses a date); everything else defaults to Haiku.
ANTHROPIC_MODEL=claude-sonnet-5
HAIKU_MODEL=claude-haiku-4-5-20251001
# Per-class override (no code change): MODEL_EXTRACTION, MODEL_RECALL, MODEL_BRIEF,
# MODEL_PRIORITIES, MODEL_SUMMARIES, MODEL_PATTERNS, MODEL_DRAFTS, MODEL_CARD_SCAN.

# --- Transcription (P1-5) ---
# stub = canned transcript (no key); groq = real Whisper (needs GROQ_API_KEY).
TRANSCRIBER=stub
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3

# --- Cloud adapters (P6-2): stub locally, real when configured ---
# Embeddings: stub | bedrock (Titan v2; needs AWS creds + BEDROCK_REGION).
EMBEDDER=stub
BEDROCK_REGION=us-east-1
EMBED_MODEL=amazon.titan-embed-text-v2:0
# Web Push: stub | webpush (needs VAPID keys — generate with `web-push generate-vapid-keys`).
PUSH_SENDER=stub
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@tovira.local
# Stripe (TEST MODE ONLY — sk_test_...). Real gateway used when STRIPE_SECRET_KEY is set.
# When STRIPE_SECRET_KEY is real, the webhook secret and BOTH price IDs must be real too.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_test
STRIPE_PRICE_ID=price_test
STRIPE_ANNUAL_PRICE_ID=price_test_annual
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel

# --- Transactional email (lifecycle + password reset + email verification) ---
# stub = records in-process (no send); ses = Amazon SES (needs SES_REGION + a
# VERIFIED EMAIL_FROM sender, and a public APP_BASE_URL above).
EMAIL_SENDER=stub
EMAIL_FROM=Tovira <no-reply@tovira.local>
SES_REGION=us-east-1

# --- Web ---
WEB_PORT=5173
